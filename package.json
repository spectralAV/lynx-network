{
	"name": "companion-module-digico-astral-orchestrator",
	"version": "0.1.0-alpha.1",
	"description": "Bitfocus Companion v3 module orchestrating Sound Devices Astral wireless telemetry, DiGiCo S21 UDP OSC proxy control, Mixing Station IEM client relays, and Stream Deck + XL Dual-Mode Panic workflows.",
	"main": "dist/main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/spectralAV/companion-module-digico-astral-orchestrator.git"
	},
	"bugs": {
		"url": "https://github.com/spectralAV/companion-module-digico-astral-orchestrator/issues"
	},
	"homepage": "https://github.com/spectralAV/companion-module-digico-astral-orchestrator#readme",
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"sim": "node mock-hardware-stage.js",
		"sim:demo": "node mock-hardware-stage.js --demo",
		"sim:once": "node mock-hardware-stage.js --duration 8",
		"test": "npm run build && node --test dist/__tests__/orchestrator.test.js"
	},
	"keywords": [
		"bitfocus-companion",
		"companion-module",
